# Local API without Docker uses SQLite. Docker Compose switches this to Postgres.
DATABASE_URL=sqlite+aiosqlite:///./data/alder.db

# Required for a spoken call: transcription, speech, extraction, and phrasing.
# Create one at https://aistudio.google.com/apikey
# Chat still works when this is empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# Empty unless you run Redis yourself. Docker Compose sets redis://redis:6379/0.
REDIS_URL=

# Empty unless you run LiveKit yourself. Docker Compose fills these.
# The dev key below matches deploy/livekit.yaml and is only for this machine.
# A public HTTPS voice deployment replaces them with LiveKit Cloud values.
LIVEKIT_URL=
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Where the voice worker posts transcripts. The API process does not need this.
API_BASE_URL=http://127.0.0.1:8000

RECORD_WEBHOOK_URL=
UPLOAD_DIR=./data/uploads
ALDER_TODAY=
GEMINI_INPUT_USD_PER_MILLION=0
GEMINI_OUTPUT_USD_PER_MILLION=0
